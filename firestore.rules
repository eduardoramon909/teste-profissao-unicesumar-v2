rules_version = '2';

// Cole este arquivo em: Firebase Console > Firestore Database > Regras > Publicar.
// (ou use `firebase deploy --only firestore:rules`)
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    //  1) TROQUE pelos e-mails da equipe que podem abrir o painel /admin.
    //     Eles precisam existir em Authentication > Users (e-mail/senha).
    // ================================================================
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['unicesumaradm@gmail.com'];
    }

    // ---------- Ações: um documento por dia (ex.: 2026-09-28) ----------
    match /acoes/{acaoId} {
      allow read: if isAdmin();
      // o quiz (público) só pode criar o dia; o nome da ação é editado só pelo admin
      allow create: if isAdmin()
        || (acaoId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data == acaoId);
      allow update, delete: if isAdmin();
    }

    // ---------- Leads ----------
    match /leads/{leadId} {
      // só o admin lê ou apaga
      allow read, delete: if isAdmin();

      // o quiz (público) cria o lead...
      allow create: if leadValido(request.resource.data)
        && request.resource.data.keys().hasAll(['nome', 'whatsapp', 'cpf', 'acaoId', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;

      // ...e o atualiza com o resultado do teste por até 6 horas (o admin edita sempre)
      allow update: if isAdmin()
        || (leadValido(request.resource.data)
            && request.time < resource.data.criadoEm + duration.value(6, 'h')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'nome', 'whatsapp', 'cpf', 'email', 'consentimento',
                 'cursoId', 'cursoPretendido', 'modalidade', 'origem', 'status',
                 'escolaridade', 'area', 'perfil', 'sugestoes', 'respostas', 'duracaoSeg',
                 'atualizadoEm'
               ])
            && request.resource.data.atualizadoEm == request.time);
    }

    // Formato permitido para um lead (vale para criar e para atualizar)
    function leadValido(d) {
      return d.keys().hasOnly([
               'nome', 'whatsapp', 'cpf', 'email', 'consentimento',
               'cursoId', 'cursoPretendido', 'modalidade', 'origem', 'status',
               'escolaridade', 'area', 'perfil', 'sugestoes', 'respostas', 'duracaoSeg',
               'acaoId', 'criadoEm', 'atualizadoEm'
             ])
        && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 120
        && d.whatsapp is string && d.whatsapp.size() >= 10 && d.whatsapp.size() <= 13
        && d.cpf is string && (d.cpf == '' || d.cpf.matches('^[0-9]{11}$'))
        && d.acaoId is string && d.acaoId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('cursoPretendido' in d) || (d.cursoPretendido is string && d.cursoPretendido.size() <= 200))
        && (!('perfil' in d) || (d.perfil is string && d.perfil.size() <= 100))
        && (!('area' in d) || (d.area is string && d.area.size() <= 100))
        && (!('escolaridade' in d) || (d.escolaridade is string && d.escolaridade.size() <= 100))
        && (!('sugestoes' in d) || (d.sugestoes is list && d.sugestoes.size() <= 5))
        && (!('respostas' in d) || (d.respostas is map && d.respostas.size() <= 40));
    }
  }
}
